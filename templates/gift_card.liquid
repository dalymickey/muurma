{%- layout none -%}
{%- liquid
  capture value
    render 'mu-money', m: gift_card.initial_value
  endcapture
  capture balance
    render 'mu-money', m: gift_card.balance
  endcapture
  capture initial
    render 'mu-money', m: gift_card.initial_value
  endcapture
  assign code = gift_card.code | format_code
  assign inactive = false
  if gift_card.enabled == false or gift_card.expired
    assign inactive = true
  endif
  assign expires = blank
  if gift_card.expires_on
    assign expires = gift_card.expires_on | date: format: 'date'
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t: value: value }} – {{ shop.name }}</title>
    {% render 'mu-head-vars' %}
    {{ 'mu-base.css' | asset_url | stylesheet_tag }}
    {{ 'mu-pages.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'mu-gift-card.js' | asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body class="color-{{ settings.page_scheme }} mu-t-gift-card">
    <main id="main" class="mu-main">
      {%- render 'mu-gift-card', balance: balance, initial: initial, code: code, qr: gift_card.qr_identifier, pass_url: gift_card.pass_url, inactive: inactive, expires: expires, shop_url: shop.url -%}
    </main>
  </body>
</html>
