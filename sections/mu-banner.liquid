    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.common.button_label",
      "default": "Shop Study 001"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.common.link"
    },
    {
      "type": "select",
      "id": "button_style",
