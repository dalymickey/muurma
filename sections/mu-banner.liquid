    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.banner.button_link_2"
    },
    {
      "type": "select",
      "id": "button_style_2",
      "label": "t:sections.banner.button_style_2",
      "default": "ghost",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.banner.style_primary"
        },
        {
          "value": "secondary",
          "label": "t:sections.banner.style_secondary"
        },
        {
          "value": "ghost",
          "label": "t:sections.banner.style_ghost"
        }
      ]
    },
    {
      "type": "text",
      "id": "fine",
