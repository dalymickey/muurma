{%- comment -%} Price with sale / compare-at. Pass product (and optionally variant). {%- endcomment -%}
{%- liquid
  assign v = variant | default: product.selected_or_first_available_variant
  assign on_sale = false
  if v.compare_at_price > v.price
    assign on_sale = true
  endif
-%}
<span class="mu-price{% if on_sale %} mu-price--sale{% endif %}" data-price>
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.sale_price' | t }}</span>
    <span class="mu-price__now">{% render 'mu-money', m: v.price %}</span>
    <span class="visually-hidden">{{ 'products.regular_price' | t }}</span>
    <s class="mu-price__was">{% render 'mu-money', m: v.compare_at_price %}</s>
  {%- elsif product.price_varies and variant == blank -%}
    {%- capture from_price -%}{%- render 'mu-money', m: product.price_min -%}{%- endcapture -%}
    {{ 'products.from' | t: price: from_price }}
  {%- else -%}
    {% render 'mu-money', m: v.price %}
  {%- endif -%}
</span>
