{%- comment -%}
  Password page: a full-height dark panel from the deep end of the scale ramp with the shop name, the heading, the
  sign-up form and a row of rising steps along the bottom. The store-owner password form opens from a link under it.
{%- endcomment -%}
{{ 'mu-sections.css' | asset_url | stylesheet_tag }}
{{ 'mu-pages.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign heading = s.heading | default: shop.password_message | default: shop.name
  assign n = settings.scale_levels | default: 6
-%}
<div class="mu-sec mu-pw {% if s.style == 'scheme' %}mu-deep--scheme color-{{ s.color_scheme }}{% render 'mu-surface', s: s %}{% else %}mu-deep mu-h-{{ n }}{% endif %}" style="--n: {{ n }}">
  <p class="mu-pw__brand">
    {%- assign pw_logo = s.logo | default: settings.logo -%}
    {%- if pw_logo != blank -%}
      {{ pw_logo | image_url: width: 240 | image_tag: alt: shop.name, class: 'mu-pw__logo', widths: '120, 240' }}
    {%- else -%}
      <span class="mu-display">{{ shop.name | escape }}</span>
    {%- endif -%}
  </p>
  <div class="mu-pw__copy">
    {%- if s.eyebrow != blank -%}<p class="mu-kicker">{{ s.eyebrow | escape }}</p>{%- endif -%}
    <h1 class="mu-pw__title mu-display">{{ heading | escape }}</h1>
    {%- if s.text != blank -%}<p class="mu-pw__text">{{ s.text | escape }}</p>{%- endif -%}
    {%- form 'customer', class: 'mu-nl__form mu-pw__form', id: 'MuPwNotify' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="mu-nl__done" role="status">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <label class="visually-hidden" for="MuPwEmail">{{ 'newsletter.email' | t }}</label>
        <input class="mu-input" id="MuPwEmail" type="email" name="contact[email]" required autocomplete="email" spellcheck="false" autocapitalize="off" placeholder="{{ 'newsletter.email' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="MuPwEmailErr"{% endif %}>
        <button class="mu-btn" type="submit">{{ 'password.notify' | t }}</button>
        {%- render 'mu-nl-terms', id: 'MuPwTerms' -%}
        {%- if form.errors -%}<p class="mu-nl__err" id="MuPwEmailErr">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
  {%- render 'mu-steps', n: n -%}
</div>

{%- capture pw_form -%}
  {%- form 'storefront_password', class: 'mu-pw__login-form', id: 'MuPwLogin' -%}
    {%- if form.errors -%}<p class="mu-form-msg mu-form-msg--error" role="alert" id="MuPwErr" data-pw-error>{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="visually-hidden" for="MuPw">{{ 'password.password' | t }}</label>
    <input class="mu-input" id="MuPw" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}" required{% if form.errors %} aria-invalid="true" aria-describedby="MuPwErr"{% endif %}>
    <button class="mu-btn" type="submit">{{ 'password.submit' | t }}</button>
  {%- endform -%}
{%- endcapture -%}
<div class="mu-pw__foot">
  <details class="mu-pw__login"{% if pw_form contains 'data-pw-error' %} open{% endif %}>
    <summary class="mu-link">{{ 'password.enter' | t }}</summary>
    {{ pw_form }}
  </details>
  <p class="mu-muted mu-pw__powered">{{ 'password.admin' | t }} <a class="mu-link" href="/admin" rel="nofollow">{{ 'password.admin_link' | t }}</a> · {{ powered_by_link }}</p>
</div>
{%- render 'mu-section-style', s: section.settings, id: section.id -%}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "mu-section",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.common.panel_style",
      "info": "t:sections.common.panel_style_info",
      "default": "ramp",
      "options": [
        {
          "value": "ramp",
          "label": "t:sections.common.panel_ramp"
        },
        {
          "value": "scheme",
          "label": "t:sections.common.panel_scheme"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.colors.scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.style == 'scheme' }}"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.main_password.logo",
      "info": "t:sections.main_password.logo_info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.eyebrow",
      "default": "Opening soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main_password.heading",
      "info": "t:sections.main_password.heading_info"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.common.text",
      "default": "Be first through the door. Get one email when we open."
    },
    {
      "type": "header",
      "content": "t:sections.common.section_margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:sections.common.margin_top",
      "info": "t:sections.common.margin_top_info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "t:sections.common.bottom_spacing",
      "info": "t:sections.common.bottom_spacing_info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_mobile",
      "label": "t:sections.common.margin_mobile",
      "info": "t:sections.common.margin_mobile_info",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 67
    },
    {
      "type": "header",
      "content": "t:sections.common.section_padding"
    },
    {
      "type": "checkbox",
      "id": "custom_padding",
      "label": "t:sections.common.custom_padding",
      "info": "t:sections.common.custom_padding_info",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:sections.common.padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:sections.common.padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.common.padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.common.padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "t:sections.common.padding_x_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_padding }}"
    }
  ]
}
{% endschema %}
