      "default": "primary",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.banner.style_primary"
        },
        {
          "value": "secondary",
          "label": "t:sections.banner.style_secondary"
        },
        {
          "value": "ghost",
          "label": "t:sections.banner.style_ghost"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.banner.button_label_2",
