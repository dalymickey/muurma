{%- comment -%}
  Predictive search results, fetched by the header's search dialog through the Section Rendering API
  (/search/suggest?section_id=mu-predictive-search). Suggested queries, products with thumbnails and prices,
  collections and pages as chips, and a link to the full results.
{%- endcomment -%}
{%- liquid
  assign r = predictive_search.resources
  assign terms = predictive_search.terms
  assign any = false
  if r.queries.size > 0 or r.products.size > 0 or r.collections.size > 0 or r.pages.size > 0
    assign any = true
  endif
-%}
<div class="mu-ps__results" data-ps-results>
  {%- if predictive_search.performed -%}
    {%- if r.queries.size > 0 -%}
      <h2 class="mu-eyebrow mu-muted mu-ps__head">{{ 'search.suggestions' | t }}</h2>
      <ul class="mu-ps__queries" role="list">
        {%- for q in r.queries -%}
          <li><a class="mu-ps__query" href="{{ q.url }}" data-ps-item>{{ q.styled_text }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if r.products.size > 0 -%}
      <h2 class="mu-eyebrow mu-muted mu-ps__head">{{ 'search.products' | t }}</h2>
      <ul class="mu-ps__products" role="list">
        {%- for p in r.products -%}
          <li>
            <a class="mu-ps__product" href="{{ p.url }}" data-ps-item>
              <span class="mu-ps__thumb">{%- if p.featured_media -%}{{ p.featured_media.preview_image | image_url: width: 440 | image_tag: loading: 'lazy', alt: '', width: 64, height: 64, widths: '150, 300, 440', sizes: '142px' }}{%- endif -%}</span>
              <span class="mu-ps__name">{{ p.title | escape }}</span>
              <span class="mu-ps__price mu-num">{%- render 'mu-price', product: p -%}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    {%- if r.collections.size > 0 or r.pages.size > 0 -%}
      <h2 class="mu-eyebrow mu-muted mu-ps__head">{{ 'search.more' | t }}</h2>
      <ul class="mu-ps__links" role="list">
        {%- for c in r.collections -%}<li><a class="mu-ps__chip" href="{{ c.url }}" data-ps-item>{{ c.title | escape }}</a></li>{%- endfor -%}
        {%- for pg in r.pages -%}<li><a class="mu-ps__chip" href="{{ pg.url }}" data-ps-item>{{ pg.title | escape }}</a></li>{%- endfor -%}
      </ul>
    {%- endif -%}
    {%- unless any -%}<p class="mu-ps__none mu-muted">{{ 'search.none' | t: terms: terms }}</p>{%- endunless -%}
    <a class="mu-btn mu-btn--secondary mu-ps__all" href="{{ routes.search_url }}?q={{ terms | url_encode }}&amp;options%5Bprefix%5D=last" data-ps-item>{{ 'search.all_results' | t: terms: terms }}{% render 'mu-icon', name: 'arrow-right' %}</a>
  {%- endif -%}
</div>
{% schema %}
{ "name": "t:sections.predictive_search.name", "settings": [] }
{% endschema %}
