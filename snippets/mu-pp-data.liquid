{%- comment -%}
  Data for assets/mu-product.js: variants (price and price in cents, stock for the Last N tip, media, SKU, unit price, quantity rule, volume pricing (breaks: [min quantity, cents, price]) and
  plan prices, the variant's own level (lv: its custom.scale metafield, 0 for none; the level block follows it), with the plan group name and the amount due today (empty when paid in full) for single-delivery plans (pre-order, try before you buy); pre: out of stock
  but still selling, when Theme settings > Pre-order covers the product, see mu-pre-ok), strings and settings. "fmt" is a sample amount in the store's money format, so the script can
  format quantity × price the same way.
  @param product {Product}
  @param s {Object} section settings
  @param colour_index {Number}
  @param stock_cap {Number} Stock level block threshold + 1, or 0 without the block. Each variant's tracked stock is
    capped at it ("stk"), so the page only learns the exact count at or under the threshold.
{%- endcomment -%}
{%- liquid
  assign low = s.low_stock | plus: 0
  assign last_index = product.options.size | minus: 1
  assign pre_label = settings.preorder_label | strip
  capture pre_ok
    render 'mu-pre-ok', product: product
  endcapture
  assign pre_ok = pre_ok | strip
  if pre_label == blank
    assign pre_label = 'products.preorder' | t
  endif
  assign last_label = s.low_stock_label | strip | replace: '[count]', '__N__'
  if last_label == blank
    assign last_label = 'products.last' | t: count: '__N__'
  endif
-%}
<script type="application/json" data-variants>
  [{%- for variant in product.variants -%}
    {%- liquid
      assign q = nil
      if low > 0 and variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
        assign q = variant.inventory_quantity
      endif
      assign img = variant.featured_media.preview_image | image_url: width: 360
      capture unit
        render 'mu-unit-price', price: variant.unit_price, measurement: variant.unit_price_measurement
      endcapture
      assign unit = unit | strip
      assign backorder = false
      if pre_ok == 'true' and variant.available and variant.inventory_management == 'shopify' and variant.inventory_policy == 'continue' and variant.inventory_quantity <= 0
        assign backorder = true
      endif
    -%}
    {"id":{{ variant.id }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{%- capture mu_m -%}{%- render 'mu-money', m: variant.price -%}{%- endcapture -%}{{ mu_m | json }},"cents":{{ variant.price }},"compare":{% if variant.compare_at_price > variant.price %}{%- capture mu_m -%}{%- render 'mu-money', m: variant.compare_at_price -%}{%- endcapture -%}{{ mu_m | json }}{% else %}null{% endif %},"qty":{{ q | json }},"media":{{ variant.featured_media.id | json }},"img":{% if variant.featured_media %}{{ img | json }}{% else %}null{% endif %},"imgpos":{% if variant.featured_media %}{{ variant.featured_media.preview_image.presentation.focal_point | append: '' | json }}{% else %}null{% endif %},"sku":{{ variant.sku | json }},"unit":{{ unit | json }},"stk":{% if stock_cap > 0 and variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 %}{{ variant.inventory_quantity | at_most: stock_cap }}{% else %}null{% endif %},"qmin":{{ variant.quantity_rule.min | default: 1 }},"qmax":{{ variant.quantity_rule.max | json }},"qstep":{{ variant.quantity_rule.increment | default: 1 }},"breaks":[{%- for qb in variant.quantity_price_breaks -%}[{{ qb.minimum_quantity }},{{ qb.price }},{%- capture mu_m -%}{%- render 'mu-money', m: qb.price -%}{%- endcapture -%}{{ mu_m | json }}]{% unless forloop.last %},{% endunless %}{%- endfor -%}],"pre":{{ backorder | json }},"lv":{% if settings.scale_mode == 'colors' %}0{% else %}{{ variant.metafields.custom.scale.value | plus: 0 }}{% endif %},"plans":{
      {%- for a in variant.selling_plan_allocations -%}
        {%- liquid
          assign pre = false
          assign due_money = ''
          if a.selling_plan.recurring_deliveries == false
            assign pre = true
            assign group = product.selling_plan_groups | where: 'id', a.selling_plan.group_id | first
            assign cc = a.selling_plan.checkout_charge
            if cc.value_type != 'percentage' or cc.value < 100
              if cc.value_type == 'percentage'
                assign due = a.price | times: cc.value | divided_by: 100
              else
                assign due = cc.value
              endif
              capture due_money
                render 'mu-money', m: due
              endcapture
            endif
          endif
        -%}
        "{{ a.selling_plan.id }}":[{%- capture mu_m -%}{%- render 'mu-money', m: a.price -%}{%- endcapture -%}{{ mu_m | json }},{% if a.compare_at_price > a.price %}{%- capture mu_m -%}{%- render 'mu-money', m: a.compare_at_price -%}{%- endcapture -%}{{ mu_m | json }}{% else %}null{% endif %},{{ a.price }}{% if pre %},{{ group.name | json }},{{ due_money | json }}{% endif %}]{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }}{% unless forloop.last %},{% endunless %}
  {%- endfor -%}]
</script>
<script type="application/json" data-strings>
  {
    "add": {{ 'products.add' | t | json }},
    "addShort": {{ 'products.add_short' | t | json }},
    "comingSoon": {{ 'products.coming_soon' | t | json }},
    "soldOut": {{ 'products.sold_out' | t | json }},
    "unavailable": {{ 'products.unavailable' | t | json }},
    "notify": {{ 'products.notify' | t | json }},
    "preorder": {{ pre_label | json }},
    "preNote": {{ settings.preorder_note | strip | json }},
    "payToday": {{ 'products.pay_today' | t: amount: '__A__' | json }},
    "added": {{ 'products.added' | t | json }},
    "error": {{ 'products.add_error' | t | json }},
    "valueSoldOut": {{ 'products.value_sold_out' | t: value: '__V__' | json }},
    "last": {{ last_label | json }},
    "lowStock": {{ 'products.low_stock' | t: count: '__N__' | json }},
    "salePrice": {{ 'products.sale_price' | t | json }},
    "regularPrice": {{ 'products.regular_price' | t | json }},
    "copied": {{ 'products.share_copied' | t | json }},
    "copyLink": {{ 'products.copy_link' | t | json }},
    "qtyIncrement": {{ 'products.qty_increment' | t: step: '__N__' | json }},
    "qtyMin": {{ 'products.qty_min' | t: min: '__N__' | json }},
    "qtyMax": {{ 'products.qty_max' | t: max: '__N__' | json }}
  }
</script>
<script type="application/json" data-config>{"low":{{ low }},"priceInButton":{{ s.price_in_button | json }},"colour":{{ colour_index }},"last":{{ last_index }},"notify":{{ s.notify | json }},"fmt":{%- capture mu_m -%}{%- render 'mu-money', m: 1234567 -%}{%- endcapture -%}{{ mu_m | json }}}</script>
