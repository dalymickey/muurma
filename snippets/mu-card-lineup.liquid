{%- comment -%}
  One numbered row for the featured collection's lineup layout. The section wraps this in the
  coloured, slightly tilted li. The number is hidden from assistive tech; the ordered list
  already announces the position.
  @param product {Product}
  @param index {Number} 1-based row
  @param numbers {String} outline or solid
  @param show_sub {Boolean} show the first selling plan when the product has one
  @param eager {Boolean} load this row's image immediately
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign n = index | default: 1
  assign num = n | prepend: '00' | slice: -2, 2
  assign kind = numbers | default: 'outline'
  assign img = product.featured_media.preview_image | default: product.featured_media
  if product.metafields.custom.cutout.value != blank
    assign cut = product.metafields.custom.cutout.value
    assign img = cut.preview_image | default: cut
  endif
  assign load = 'lazy'
  if eager
    assign load = 'eager'
  endif
  assign sub = nil
  if show_sub and product.selling_plan_groups.size > 0
    assign sub = v.selling_plan_allocations.first
  endif
-%}
<article class="mu-lineup__card">
  <p class="mu-lineup__no mu-lineup__no--{{ kind }}" aria-hidden="true">{{ num }}</p>
  <div class="mu-lineup__copy">
    <h3 class="mu-lineup__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
  </div>
  <div class="mu-lineup__media">
    {%- render 'mu-stickers', product: product -%}
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if img -%}
        {% render 'mu-img', image: img, max: 800, sizes: '(min-width: 750px) 220px, 70vw', loading: load, alt: '' %}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'mu-placeholder' }}
      {%- endif -%}
    </a>
  </div>
  <div class="mu-lineup__buy">
    <p class="mu-lineup__price">{% render 'mu-price', product: product %}</p>
    {%- if sub -%}
      <p class="mu-lineup__sub">
        <span class="visually-hidden">{{ 'products.plans' | t }} </span>
        {%- if sub.price < v.price -%}
          <span class="mu-lineup__subprice">{% render 'mu-money', m: sub.price %}</span>
        {%- endif -%}
        <span>{{ sub.selling_plan.name | escape }}</span>
      </p>
    {%- endif -%}
  </div>
</article>
