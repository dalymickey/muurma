{%- comment -%}
  Share tags (Open Graph and X/Twitter card) for every page. Title and description come from the page's SEO fields,
  falling back to the store name and description. The image is page_image: the product, collection or article image,
  or the store's social sharing image (Online Store > Preferences) elsewhere. Products add their price.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  if request.page_type == 'cart'
    assign og_title = 'cart.title' | t
  endif
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  {%- liquid
    assign og_img = page_image | image_url: width: 1200 | prepend: 'https:'
    assign og_w = page_image.width | at_most: 1200
    assign og_h = og_w | divided_by: page_image.aspect_ratio | round
    assign og_alt = page_image.alt | default: og_title
  -%}
  <meta property="og:image" content="{{ og_img }}">
  <meta property="og:image:secure_url" content="{{ og_img }}">
  <meta property="og:image:width" content="{{ og_w }}">
  <meta property="og:image:height" content="{{ og_h }}">
  <meta property="og:image:alt" content="{{ og_alt | escape }}">
{%- endif -%}
{%- if request.page_type == 'product' and product -%}
  {%- assign og_v = product.selected_or_first_available_variant -%}
  <meta property="og:price:amount" content="{{ og_v.price | money_without_currency | strip_html | escape }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- elsif request.page_type == 'article' and article -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- if article.author != blank %}<meta property="article:author" content="{{ article.author | escape }}">{% endif -%}
{%- endif %}
<meta name="twitter:card" content="{% if page_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if page_image %}
  <meta name="twitter:image" content="{{ og_img }}">
  <meta name="twitter:image:alt" content="{{ og_alt | escape }}">
{%- endif %}
