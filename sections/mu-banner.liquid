      "options": [
        {
          "value": "h1",
          "label": "t:sections.banner.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.banner.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.banner.h3"
        }
      ]
    },
    {
      "type": "text",
      "id": "subheading",
