{{ 'mu-pages.css' | asset_url | stylesheet_tag }}
<div class="mu-sec mu-sp mu-lc color-{{ section.settings.color_scheme }}{% render 'mu-surface', s: section.settings %}">
<header class="mu-page"><h1 class="mu-page__title">{{ 'collections.all_title' | t }}</h1></header>
{%- paginate collections by 24 -%}
  <ul class="mu-lc-grid" role="list">
    {%- for c in collections -%}
      <li>
        <a class="mu-card__link" href="{{ c.url }}">
          <div class="mu-card__media">
            {%- if c.featured_image -%}
              {%- capture lc_sizes -%}{% render 'mu-sizes', sub: 80, f: 0.3333, tab: 'calc(50vw - 30px)', mob: 'calc(50vw - 15px)' %}{%- endcapture -%}
              {% render 'mu-img', image: c.featured_image, max: 1200, sizes: lc_sizes, class: 'mu-card__img', alt: c.featured_image.alt %}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'mu-placeholder' }}
            {%- endif -%}
          </div>
          <h2 class="mu-card__title">{{ c.title | escape }}</h2>
          <p class="mu-card__price mu-num">{{ 'collections.count' | t: count: c.products_count }}</p>
        </a>
      </li>
    {%- endfor -%}
  </ul>
  {%- render 'mu-pagination', paginate: paginate -%}
{%- endpaginate -%}
</div>
{%- render 'mu-section-style', s: section.settings, id: section.id -%}

{% schema %}
{
  "name": "t:sections.main_list_collections.name",
  "class": "mu-main-list-collections",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.colors.scheme",
      "info": "t:sections.common.page_scheme_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.common.section_margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:sections.common.margin_top",
      "info": "t:sections.common.margin_top_info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "t:sections.common.bottom_spacing",
      "info": "t:sections.common.bottom_spacing_info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_mobile",
      "label": "t:sections.common.margin_mobile",
      "info": "t:sections.common.margin_mobile_info",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 67
    },
    {
      "type": "header",
      "content": "t:sections.common.section_padding"
    },
    {
      "type": "checkbox",
      "id": "custom_padding",
      "label": "t:sections.common.custom_padding",
      "info": "t:sections.common.custom_padding_info",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:sections.common.padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:sections.common.padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.common.padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.common.padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "t:sections.common.padding_x_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_padding }}"
    }
  ]
}
{% endschema %}
