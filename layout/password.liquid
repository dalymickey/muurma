<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{ shop.name }}</title>
    {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% render 'mu-head-vars' %}
    {{ 'mu-base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="color-{{ settings.page_scheme }} mu-t-password">
    <main id="main" class="mu-main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
