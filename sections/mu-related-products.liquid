{%- comment -%}
  Pairs well: Shopify's related product recommendations in a product band (level swatch and heading). Until the
  recommendations arrive (and if there are none yet), the fallback collection fills the band, minus the current product.
  Phones: a swipe rail. Desktop: a 4-up grid.
{%- endcomment -%}
{{ 'mu-sections.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign limit = s.limit
  assign items = blank
  if recommendations.performed? and recommendations.products_count > 0
    assign items = recommendations.products
    assign from_recs = true
  else
    assign from_recs = false
    assign c = s.collection
    if c == blank and product != blank
      for col in product.collections
        if col.products_count > limit
          assign c = col
          break
        endif
      endfor
      if c == blank
        for col in product.collections
          if col.products_count > 1
            assign c = col
            break
          endif
        endfor
      endif
    endif
    if c != blank
      assign items = c.products
    endif
  endif
-%}
<div class="mu-sec mu-rel" data-rel{% if product != blank %} data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=related"{% endif %}{% render 'mu-anim', on: section.settings.animate, items: '' %}>
  {%- if items != blank -%}
    <div class="mu-fc mu-rel__band color-{{ s.color_scheme }}{% render 'mu-surface', s: s %}"{% render 'mu-surface', s: s, part: 'attr' %}>
      {%- if s.heading != blank -%}
        <div class="mu-fc__head"><h2 class="mu-fc__title">{{ s.heading | escape }}</h2></div>
      {%- endif -%}
      {%- if s.layout == 'lineup' -%}
      {{ 'mu-card-lineup.css' | asset_url | stylesheet_tag }}
      <ol class="mu-lineup" role="list">
        {%- assign shown = 0 -%}
        {%- for item in items -%}
          {%- if shown < limit and item.id != product.id -%}
            {%- assign shown = shown | plus: 1 -%}
            <li class="mu-lineup__row">{% render 'mu-card', product: item, layout: 'lineup', lineup_index: shown, lineup_numbers: 'outline', show_sub: true %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- else -%}
      <ul class="mu-fc__rail mu-rail" role="list">
        {%- assign shown = 0 -%}
        {%- for item in items -%}
          {%- if shown < limit and item.id != product.id -%}
            {%- assign shown = shown | plus: 1 -%}
            <li class="mu-fc__item">{% render 'mu-card', product: item, sizes: 'rail' %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
    </div>
  {%- endif -%}
</div>
{%- unless from_recs -%}
  <script>
    (() => {
      const box = document.currentScript.previousElementSibling;
      const url = box && box.dataset.url;
      if (!url || !('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        try {
          const html = await (await fetch(url)).text();
          const next = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-rel]');
          const count = (root) => root.querySelectorAll('.mu-fc__item, .mu-lineup__row').length;
          if (next && count(next) >= count(box)) box.replaceChildren(...next.childNodes);
        } catch (err) { /* keep the fallback */ }
      }, { rootMargin: '400px 0px' });
      io.observe(box);
    })();
  </script>
{%- endunless -%}
<style>
  .mu-rel .mu-fc__rail { --item: var(--mu-card-m, 62%); }
  @media (min-width: 750px) { .mu-rel .mu-fc__rail { --item: 30%; } }
  @media (min-width: 990px) { .mu-rel .mu-fc { padding-top: 88px; } .mu-rel .mu-fc__title { font-size: calc(36px * var(--mu-heading-scale)); } }
</style>
{%- render 'mu-section-style', s: section.settings, id: section.id -%}

{% schema %}
{
  "name": "t:sections.related.name",
  "class": "mu-section mu-section--related",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.colors.scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "t:sections.common.layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.common.bg_full",
      "info": "t:sections.common.bg_full_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "custom_radius",
      "label": "t:sections.common.custom_radius",
      "info": "t:sections.common.custom_radius_info",
      "default": false,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "range",
      "id": "radius",
      "label": "t:sections.common.radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.full_width == false and section.settings.custom_radius }}"
    },
    {
      "type": "checkbox",
      "id": "round_tl",
      "label": "t:sections.common.round_tl",
      "default": true,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "checkbox",
      "id": "round_tr",
      "label": "t:sections.common.round_tr",
      "default": true,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "checkbox",
      "id": "round_bl",
      "label": "t:sections.common.round_bl",
      "default": true,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "checkbox",
      "id": "round_br",
      "label": "t:sections.common.round_br",
      "default": true,
      "visible_if": "{{ section.settings.full_width == false }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.common.heading",
      "default": "Pairs well"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.related.layout",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.related.layout_grid"
        },
        {
          "value": "lineup",
          "label": "t:sections.related.layout_lineup"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:sections.featured_collection.limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.related.collection",
      "info": "t:sections.related.collection_info"
    },
    {
      "type": "header",
      "content": "t:sections.common.animation"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "t:sections.common.animate",
      "info": "t:sections.common.animate_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.section_margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:sections.common.margin_top",
      "info": "t:sections.common.margin_top_info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "t:sections.common.bottom_spacing",
      "info": "t:sections.common.bottom_spacing_info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_mobile",
      "label": "t:sections.common.margin_mobile",
      "info": "t:sections.common.margin_mobile_info",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 67
    },
    {
      "type": "header",
      "content": "t:sections.common.section_padding"
    },
    {
      "type": "checkbox",
      "id": "custom_padding",
      "label": "t:sections.common.custom_padding",
      "info": "t:sections.common.custom_padding_info",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:sections.common.padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:sections.common.padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.common.padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.common.padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "t:sections.common.padding_x_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_padding }}"
    }
  ],
  "presets": [
    {
      "name": "t:sections.related.name"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  }
}
{% endschema %}
