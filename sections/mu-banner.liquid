{%- comment -%}
  Full-bleed hero. A photograph (or a muted video) with a dark coastal veil, optional film grain
  and a contour-line overlay. Copy sits bottom-left by default: a tracked kicker, a study label,
  a condensed headline, a lede, a primary button, a text link and fine print.
  An empty image picker shows the packaged asset named in Packaged photo.
{%- endcomment -%}
{{ 'mu-banner.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign htag = s.heading_tag | default: 'h2'
  if htag != 'h1' and htag != 'h2' and htag != 'h3'
    assign htag = 'h2'
  endif
  assign focal = '50% 38%'
  if s.image != blank and s.image.presentation.focal_point != blank
    assign focal = s.image.presentation.focal_point
  endif
  assign demo_loading = 'lazy'
  assign demo_fp = ''
  if section.index == 1
    assign demo_loading = 'eager'
    assign demo_fp = 'high'
  endif
  capture demo_banner
    render 'mu-demo-image', asset: s.demo_image, class: 'mu-banner__img', sizes: '100vw', alt: '', style: 'object-position: var(--mu-banner-focal, 50% 38%);', loading: demo_loading, fetchpriority: demo_fp
  endcapture
  assign demo_banner = demo_banner | strip
  assign has_media = false
  if s.image != blank or s.video != blank or demo_banner != ''
    assign has_media = true
  endif
  assign show_media = has_media
  if request.design_mode and has_media == false
    assign show_media = true
  endif
  assign ov = s.overlay_color | default: '#2b2c2b'
  assign strength = s.overlay_opacity | default: 80 | divided_by: 100.0
  assign top_a = strength | times: 0.9
  assign bot_a = strength
  assign bot_mid = bot_a | times: 0.7
  assign bot_soft = bot_a | times: 0.25
  assign grain_a = s.grain_opacity | default: 42 | divided_by: 100.0
  assign contour_a = s.contour_opacity | default: 14 | divided_by: 100.0
  assign grain_url = 'mu-grain.jpg' | asset_url
  if s.grain_image != blank
    assign grain_url = s.grain_image | image_url: width: 512
  endif
  assign hero_size = s.height | default: 'screen'
  if hero_size == blank
    assign hero_size = 'screen'
  endif
  assign hero_h = 'clamp(420px, 62svh, 680px)'
  case hero_size
    when 'small'
      assign hero_h = 'clamp(280px, 42svh, 460px)'
    when 'medium'
      assign hero_h = 'clamp(380px, 58svh, 620px)'
    when 'large'
      assign hero_h = 'clamp(480px, 74svh, 820px)'
    when 'screen'
      assign hero_h = 'max(100svh, min(62.5vw, 900px))'
  endcase
  assign hero_size_m = s.height_mobile | default: 'screen'
  if hero_size_m == blank or hero_size_m == 'same'
    assign hero_h_m = hero_h
  else
    assign hero_h_m = hero_h
    case hero_size_m
      when 'small'
        assign hero_h_m = 'clamp(240px, 48svh, 420px)'
      when 'medium'
        assign hero_h_m = 'clamp(320px, 60svh, 520px)'
      when 'large'
        assign hero_h_m = 'clamp(400px, 74svh, 640px)'
      when 'screen'
        assign hero_h_m = '100svh'
    endcase
  endif
-%}
{%- if s.video != blank -%}<script src="{{ 'mu-video.js' | asset_url }}" defer></script>{%- endif -%}
{%- if section.index == 1 -%}
  <style>:root { --mu-hero-fg: {{ settings.color_schemes[s.color_scheme].settings.text }}; }</style>
{%- endif -%}
<div
  class="mu-sec mu-banner mu-bleed mu-banner--{{ hero_size }} mu-banner--m-{{ hero_size_m }} mu-banner--at-{{ s.content_position }} mu-banner--align-{{ s.text_align }} color-{{ s.color_scheme }}"
  data-mu-over
  style="--mu-b-h: {{ hero_h }}; --mu-b-h-m: {{ hero_h_m }}; --mu-banner-focal: {{ focal }};{% if s.image == blank %} --mu-banner-focal-m: 50% 28%;{% endif %} --mu-banner-ov: {{ ov }}; --mu-grain-a: {{ grain_a }}; --mu-contour-a: {{ contour_a }}; --mu-grain: url('{{ grain_url }}');"
>
  {%- render 'mu-section-style', s: section.settings, part: 'bg' -%}
  {%- if show_media -%}
    <div class="mu-banner__media">
      {%- if s.video != blank -%}
        {%- render 'mu-bgvideo', video: s.video, poster: s.image, class: 'mu-banner__video', media_class: 'mu-banner__vid', ctl: 'mu-banner__vctl' -%}
      {%- elsif s.image != blank -%}
        {%- if section.index == 1 -%}
          {%- render 'mu-img', image: s.image, class: 'mu-banner__img', sizes: '100vw', alt: '', fp: 'high', preload: true, style: 'object-position: var(--mu-banner-focal, 50% 38%);' -%}
        {%- else -%}
          {%- render 'mu-img', image: s.image, class: 'mu-banner__img', sizes: '100vw', alt: '', style: 'object-position: var(--mu-banner-focal, 50% 38%);' -%}
        {%- endif -%}
      {%- elsif demo_banner != '' -%}
        {{ demo_banner }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'mu-banner__ph' }}
      {%- endif -%}
    </div>
  {%- endif -%}
  <div class="mu-banner__veil mu-banner__veil--top" style="background: linear-gradient(to bottom, {{ ov | color_modify: 'alpha', top_a }} 0%, {{ ov | color_modify: 'alpha', 0 }} 100%);" aria-hidden="true"></div>
  <div class="mu-banner__veil mu-banner__veil--bottom" style="background: linear-gradient(to top, {{ ov | color_modify: 'alpha', bot_a }} 0%, {{ ov | color_modify: 'alpha', bot_mid }} 28%, {{ ov | color_modify: 'alpha', bot_soft }} 62%, {{ ov | color_modify: 'alpha', 0 }} 100%);" aria-hidden="true"></div>
  {%- if s.show_contour -%}
    <div class="mu-banner__motif" aria-hidden="true">
      {%- if s.contour_image != blank -%}
        {{ s.contour_image | image_url: width: 1600 | image_tag: alt: '', class: 'mu-banner__motif-img' }}
      {%- else -%}
        <img class="mu-banner__motif-img" src="{{ 'mu-contours.svg' | asset_url }}" alt="" width="1440" height="900">
      {%- endif -%}
    </div>
  {%- endif -%}
  {%- if s.show_grain -%}
    <div class="mu-banner__grain" aria-hidden="true"></div>
  {%- endif -%}
  <div class="mu-banner__frame">
    <div class="mu-banner__copy">
      {%- if s.eyebrow != blank -%}<p class="mu-banner__eyebrow"><span class="mu-banner__rule" aria-hidden="true"></span>{{ s.eyebrow | escape }}</p>{%- endif -%}
      <div class="mu-banner__titles">
        {%- if s.study != blank -%}<p class="mu-banner__study">{{ s.study | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<{{ htag }} class="mu-banner__title">{{ s.heading }}</{{ htag }}>{%- endif -%}
      </div>
      {%- if s.subheading != blank -%}<p class="mu-banner__sub">{{ s.subheading | escape }}</p>{%- endif -%}
      {%- if s.button_label != blank or s.button_label_2 != blank -%}
        <div class="mu-banner__actions">
          {%- if s.button_label != blank -%}
            {%- if s.button_link != blank -%}
              <a class="mu-btn{% if s.button_style == 'secondary' %} mu-btn--secondary{% elsif s.button_style == 'ghost' %} mu-banner__textlink{% endif %}" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>
            {%- else -%}
              <a class="mu-btn{% if s.button_style == 'secondary' %} mu-btn--secondary{% elsif s.button_style == 'ghost' %} mu-banner__textlink{% endif %}" href="{{ routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
            {%- endif -%}
          {%- endif -%}
          {%- if s.button_label_2 != blank -%}
            {%- if s.button_link_2 != blank -%}
              <a class="{% if s.button_style_2 == 'ghost' %}mu-banner__textlink{% else %}mu-btn{% if s.button_style_2 == 'secondary' %} mu-btn--secondary{% endif %}{% endif %}" href="{{ s.button_link_2 }}">{{ s.button_label_2 | escape }}{% if s.button_style_2 == 'ghost' %} <span aria-hidden="true">→</span>{% endif %}</a>
            {%- else -%}
              <span class="{% if s.button_style_2 == 'ghost' %}mu-banner__textlink{% else %}mu-btn{% if s.button_style_2 == 'secondary' %} mu-btn--secondary{% endif %}{% endif %}">{{ s.button_label_2 | escape }}{% if s.button_style_2 == 'ghost' %} <span aria-hidden="true">→</span>{% endif %}</span>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- if s.fine != blank -%}<p class="mu-banner__fine">{{ s.fine | escape }}</p>{%- endif -%}
    </div>
  </div>
</div>
{%- render 'mu-section-style', s: section.settings, id: section.id -%}

{% schema %}
{
