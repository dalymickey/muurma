{%- comment -%}
  The store logo from Theme settings > Logo. On a dark color scheme (background brightness under 50%) it uses the
  light logo when one is set; otherwise the main logo. Renders nothing when no logo is set, so callers can fall back
  to a wordmark.
  Sizing is done here in whole pixels so the logo stays sharp: the height follows from the width and the image's own
  aspect ratio; max_height caps the height and scales the width down with it. The image is requested at exactly 1x,
  2x and 3x of that box (cropped to the box's exact ratio, never upscaled) and offered with x descriptors.
  Params: scheme (color scheme id of the background), width (display width in px), max_height (optional cap in px),
  class, loading ('eager' or 'lazy').
{%- endcomment -%}
{%- liquid
  assign img = settings.logo
  assign sid = scheme | append: ''
  if sid == blank
    assign sid = settings.page_scheme | append: ''
  endif
  assign bg = settings.color_schemes[sid].settings.background
  if bg != blank and settings.logo_light != blank
    assign bg_b = bg | color_brightness
    if bg_b < 128
      assign img = settings.logo_light
    endif
  endif
  if img != blank
    assign ar = img.aspect_ratio | default: 1.0 | times: 1.0
    assign w = width | default: 140 | round
    assign h = w | divided_by: ar | round
    assign cap = max_height | default: 0 | round
    if cap > 0 and h > cap
      assign h = cap
      assign w = cap | times: ar | round
    endif
    assign srcset = ''
    assign src = ''
    for k in (1..3)
      assign kw = w | times: k
      assign kh = h | times: k
      if k > 1 and kw > img.width
        break
      endif
      if kh > img.height
        break
      endif
      assign u = img | image_url: width: kw, height: kh, crop: 'center'
      if k == 1
        assign src = u
      else
        assign srcset = srcset | append: ', '
      endif
      assign srcset = srcset | append: u | append: ' ' | append: k | append: 'x'
    endfor
    if src == blank
      assign src = img | image_url: width: w
      assign srcset = src | append: ' 1x'
    endif
  endif
-%}
{%- if img != blank -%}
  {%- # theme-check-disable RemoteAsset -%}
  <img src="{{ src }}" srcset="{{ srcset }}" width="{{ w }}" height="{{ h }}" alt="{{ img.alt | default: shop.name | escape }}" class="mu-logo {{ class }}" loading="{{ loading | default: 'lazy' }}" style="width: {{ w }}px; aspect-ratio: {{ w }} / {{ h }}">
  {%- # theme-check-enable RemoteAsset -%}
{%- endif -%}
