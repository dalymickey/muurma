{%- comment -%}
  Product page. Phones: the rounded media stage (swipe the media, dots at the foot), then the buy area on the page
  colours, then the sticky add bar once the main button scrolls away. Desktop: the stage with a thumbnail column
  beside a sticky buy panel in its own scheme, led by the level meter.
  The buy area is built from blocks (snippets/mu-pp-block, shared with the featured product section). The variant
  picker shows a colour option (by name or swatches) as thumbnails and every other option as wrapping chips,
  with a "Last N" tip (Low stock tip label, [count] for the number) on the selected size when its tracked stock is
  at or under the low-stock threshold. The Stock level block is a separate line and bar with its own threshold.
  Collapsible rows layout: Tabs turns each run of collapsible rows into a tablist from 750px; phones keep accordions.
  Release: when the product metafield custom.release_date (date or date and time) is in the future, the buy buttons
  block shows "Coming {date}" and the notify form instead, and flips to the normal buttons once the date passes.
{%- endcomment -%}
{{ 'mu-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mu-product.js' | asset_url }}" defer></script>
{%- liquid
  assign s = section.settings
  assign v = product.selected_or_first_available_variant
  assign uid = section.id
  assign ps = s.panel_scheme.settings
  assign form_id = 'MuForm-' | append: uid
  capture ci
    render 'mu-pp-colour-index', product: product
  endcapture
  assign colour_index = ci | strip | plus: 0
  capture rs
    render 'mu-pp-release', product: product
  endcapture
  assign release_s = rs | strip | plus: 0
  assign coming = false
  if release_s > 0
    assign coming = true
  endif
  assign split_at = -1
  for block in section.blocks
    if block.type == 'below_media'
      assign split_at = forloop.index0
      assign below_block = block
      break
    endif
  endfor
  assign pp_lv = 0
  assign pp_tc = ''
  assign pp_ts = ''
  assign pp_sc = 0
  assign crumb = collection
  if crumb == blank
    assign crumb = product.collections.first
  endif
-%}
{%- liquid
  comment
    The "Below media" card takes the buy panel's colors unless its block picks its own scheme (desktop only, like the panel).
  endcomment
  assign cs = ps
  if below_block and below_block.settings.card_colors == 'scheme' and below_block.settings.card_scheme != blank
    assign cs = below_block.settings.card_scheme.settings
  endif
-%}
<style>
  @media (min-width: 990px) {
    {%- for sc in (1..2) -%}
      {%- if sc == 1 -%}{%- assign k = ps -%}{%- assign sel = '.mu-pp__panel' -%}{%- else -%}{%- assign k = cs -%}{%- assign sel = '.mu-pp__below' -%}{%- endif -%}
      {%- assign kb = k.background | color_brightness %}
    #MuPP-{{ uid }} {{ sel }} {
      --bg: {{ k.background }}; --band: {{ k.band }}; --fg: {{ k.text }}; --mu: {{ k.muted }}; --acc: {{ k.accent }};
      --btn: {{ k.button }}; --btn-fg: {{ k.button_label }}; --ring: {{ k.button_ring }}; --btn2: {{ k.secondary }};
      --btn2-fg: {{ k.secondary_label }}; --link: {{ k.link }}; --bd: {{ k.border }}; --sale: {{ k.sale }}; --focus: {{ k.text }}; --ok: {% if kb < 128 %}var(--mu-ok-dark){% else %}var(--mu-ok-light){% endif %};
      background-color: var(--bg); color: var(--fg);
    }
    {%- endfor %}
  }
</style>
{%- comment -%} Breadcrumb: a slim row above the gallery, so it never sits on the photo. {%- endcomment -%}
<nav class="mu-pp__crumb mu-muted" aria-label="{{ 'products.breadcrumb' | t }}">
  {%- if crumb != blank -%}<a href="{{ crumb.url }}">{{ crumb.title | escape }}</a> <span aria-hidden="true">/</span> {% endif -%}
  <span aria-current="page">{{ product.title | escape }}</span>
</nav>
<div class="mu-sec mu-pp{% if pp_lv > 0 %} mu-h-{{ pp_lv }}{% endif %}{% if pp_sc == 2 %} mu-s2{% endif %}{{ pp_tc }}"{% if pp_ts != blank %} style="{{ pp_ts }}"{% endif %} id="MuPP-{{ uid }}" data-pp data-section="{{ uid }}" data-url="{{ product.url }}"{% if coming %} data-release="{{ release_s }}"{% endif %}>
  {%- render 'mu-pp-media', product: product, media_scheme: s.media_scheme, media_style: s.media_style, media_ratio: s.media_ratio, eager: true, zoom: s.image_zoom -%}

  {%- comment -%} Buy area {%- endcomment -%}
  <div class="mu-pp__panel " data-panel>
    {%- comment -%} No Purchase options block: the buy buttons show the purchase options themselves when the product has any, so a plan can always be picked. {%- endcomment -%}
      {%- assign plan_blocks = section.blocks | where: 'type', 'selling_plan' -%}
      {%- assign plans_auto = false -%}{%- if plan_blocks.size == 0 and product.selling_plan_groups.size > 0 %}{% assign plans_auto = true %}{% endif -%}
      {%- for block in section.blocks -%}
      {%- if split_at >= 0 and forloop.index0 >= split_at -%}{%- break -%}{%- endif -%}
      {%- liquid
        assign prev_block = nil
        unless forloop.first
          assign pi = forloop.index0 | minus: 1
          assign prev_block = section.blocks[pi]
        endunless
        assign next_block = section.blocks[forloop.index]
      -%}
      {%- case block.type -%}
      {%- when '@app' -%}
        <div class="mu-pp__app" {{ block.shopify_attributes }}>{% render block %}</div>
      {%- else -%}
        {%- render 'mu-pp-block', block: block, product: product, v: v, uid: uid, s: s, form_id: form_id, colour_index: colour_index, coming: coming, release_s: release_s, prev_block: prev_block, next_block: next_block, plans_auto: plans_auto, feature: false -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>

  {%- if split_at >= 0 -%}
    {%- comment -%}
      Blocks after the "Below media" block: a card under the media on desktop, so a long buy area doesn't leave a gap
      under the gallery. On phones they follow the buy area in the same order. Blocks with nothing to show (spec tiles
      without values, an empty text) render nothing; the card is left out when none has content, and starts hidden when
      complementary products is its only content, until the recommendations arrive (assets/mu-product.js).
    {%- endcomment -%}
    {%- liquid
      assign below_html = ''
      assign below_shown = false
      assign below_rk = 100
      for block in section.blocks
        if forloop.index0 <= split_at
          continue
        endif
        if block.type == 'ticker' and block.settings.style == 'pill' and block.settings.radius != blank
          assign below_rk = block.settings.radius
        endif
        assign prev_block = nil
        unless forloop.first
          assign pi = forloop.index0 | minus: 1
          assign prev_block = section.blocks[pi]
        endunless
        assign next_block = section.blocks[forloop.index]
        case block.type
          when '@app'
          capture bh
            echo '<div class="mu-pp__app" {{ block.shopify_attributes }}>'
            render block
            echo '</div>'
          endcapture
          assign below_shown = true
        else
          capture bh
            render 'mu-pp-block', block: block, product: product, v: v, uid: uid, s: s, form_id: form_id, colour_index: colour_index, coming: coming, release_s: release_s, prev_block: prev_block, next_block: next_block, plans_auto: plans_auto, feature: false
          endcapture
          if block.type != 'complementary'
            assign bt = bh | strip_html | strip
            if bt != blank or bh contains '<img' or bh contains '<svg' or bh contains 'mu-pp__feat-mask' or bh contains '<iframe' or bh contains '<video'
              assign below_shown = true
            endif
          endif
        endcase
        assign below_html = below_html | append: bh
      endfor
      if request.design_mode
        assign below_shown = true
      endif
      assign below_trim = below_html | strip
    -%}
    {%- if below_trim != blank -%}
      <div class="mu-pp__below" data-below{% unless below_shown %} hidden{% endunless %} style="--below-pad: {{ below_block.settings.card_padding | default: 36 }}px;{% if below_rk != 100 %} --tk-rk: {{ below_rk | divided_by: 100.0 }}{% endif %}">
        {{- below_html -}}
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if s.sticky_bar -%}
    <div class="mu-pp-bar color-{{ s.bar_scheme }}" data-bar aria-hidden="true">
      {%- if v.featured_media or product.featured_media -%}
        {{- v.featured_media.preview_image | default: product.featured_media.preview_image | image_url: width: 144 | image_tag: alt: '', class: 'mu-pp-bar__img', loading: 'lazy', width: 44, height: 44, widths: '48, 96, 144', sizes: '44px', data-bar-img: '' -}}
      {%- endif -%}
      <div class="mu-pp-bar__text">
        <b>{{ product.title | escape }}</b>
        <span class="mu-muted" data-bar-sum>{% unless product.has_only_default_variant %}{{ v.options | join: ' · ' | escape }}{% endunless %}</span>
      </div>
      <button type="button" class="mu-btn mu-pp-bar__btn" data-bar-btn tabindex="-1"{% if coming and s.notify == false %} disabled{% endif %}>
        {%- if coming and s.notify -%}{{ 'products.notify' | t }}{%- elsif coming -%}{{ 'products.coming_soon' | t }}{%- elsif v.available -%}{%- render 'mu-pp-pre', product: product, v: v, part: 'label', fallback: 'products.add_short' -%}{% if s.price_in_button %} · {% render 'mu-money', m: v.price %}{% endif %}{%- elsif s.notify -%}{{ 'products.notify' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
      </button>
    </div>
  {%- endif -%}

  {%- liquid
    assign stock_cap = 0
    assign stock_block = section.blocks | where: 'type', 'stock_level' | first
    if stock_block
      assign stock_cap = stock_block.settings.threshold | plus: 1
    endif
  -%}
  {%- render 'mu-pp-data', product: product, s: s, colour_index: colour_index, stock_cap: stock_cap -%}
</div>
{%- render 'mu-section-style', s: section.settings, id: section.id -%}

