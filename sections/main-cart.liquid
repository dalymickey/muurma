{%- comment -%}
  Cart page: the bag lines as open rows with inline steppers, free shipping progress on the scale ramp, "Make it a
  upsell", a perks strip (blocks) and a sticky order summary. The bag markup is shared with the drawer (mu-cart-body).
{%- endcomment -%}
{{ 'mu-cart.css' | asset_url | stylesheet_tag }}
<mu-cart class="mu-sec mu-sp mu-cart-page color-{{ section.settings.color_scheme }}{% render 'mu-surface', s: section.settings %}" data-section="{{ section.id }}" data-updated="{{ 'cart.updated' | t | escape }}" data-error="{{ 'cart.error' | t | escape }}">
  {%- render 'mu-cart-body', mode: 'page', sid: section.id, summary_scheme: section.settings.summary_scheme, perks: section.blocks, show_payments: section.settings.show_payments -%}
</mu-cart>
<script src="{{ 'mu-cart.js' | asset_url }}" defer></script>
{%- render 'mu-section-style', s: section.settings, id: section.id -%}

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "class": "mu-main-cart",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.colors.scheme",
      "info": "t:sections.common.page_scheme_info",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "summary_scheme",
      "label": "t:sections.main_cart.summary_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_payments",
      "label": "t:sections.main_cart.show_payments",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.section_margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "t:sections.common.margin_top",
      "info": "t:sections.common.margin_top_info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "bottom_spacing",
      "label": "t:sections.common.bottom_spacing",
      "info": "t:sections.common.bottom_spacing_info",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_mobile",
      "label": "t:sections.common.margin_mobile",
      "info": "t:sections.common.margin_mobile_info",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 67
    },
    {
      "type": "header",
      "content": "t:sections.common.section_padding"
    },
    {
      "type": "checkbox",
      "id": "custom_padding",
      "label": "t:sections.common.custom_padding",
      "info": "t:sections.common.custom_padding_info",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "t:sections.common.padding_left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "t:sections.common.padding_right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "t:sections.common.padding_top_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "t:sections.common.padding_bottom_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40,
      "visible_if": "{{ section.settings.custom_padding }}"
    },
    {
      "type": "range",
      "id": "padding_x_mobile",
      "label": "t:sections.common.padding_x_mobile",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_padding }}"
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "t:sections.main_cart.perk",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.common.heading",
          "default": "Free returns"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.common.text",
          "default": "30 days, any reason"
        }
      ]
    }
  ]
}
{% endschema %}
