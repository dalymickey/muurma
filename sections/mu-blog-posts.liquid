{%- comment -%}
  Blog posts: the latest stories from a blog in a product band (level swatch and heading) and a "See all" link.
  Grid (the default): phones swipe, desktop is a 3-up grid.
  Feature and list: the newest story as a feature card, then the rest as a numbered list.
  On the product and collection templates as well as the home page.
  With no blog chosen or zero articles, the storefront renders nothing; the theme editor shows placeholder cards.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign b = s.blog
  assign mu_posts = false
  if b != blank and b.articles_count > 0
    assign mu_posts = true
  endif
  if request.design_mode
    assign mu_posts = true
  endif
-%}
{%- if mu_posts -%}
{{ 'mu-sections.css' | asset_url | stylesheet_tag }}
{%- if s.layout == 'feature_list' -%}{{ 'mu-pages.css' | asset_url | stylesheet_tag }}{%- endif -%}
<div class="mu-sec mu-fc mu-bp color-{{ s.color_scheme }}{% render 'mu-surface', s: s %}"{% render 'mu-surface', s: s, part: 'attr' %}{% render 'mu-anim', on: section.settings.animate, items: '.mu-fc__title, .mu-fc__item, .mu-bpl__link, .mu-feat' %}>
  {%- render 'mu-section-style', s: section.settings, part: 'bg' -%}
  {%- if s.heading != blank -%}
    <div class="mu-fc__head"><h2 class="mu-fc__title">{{ s.heading | escape }}</h2></div>
  {%- endif -%}
  {%- if b != blank and s.show_link -%}
    <a class="mu-fc__all mu-link" href="{{ b.url }}">{{ 'sections.see_all' | t: count: b.articles_count }}</a>
  {%- endif -%}
  {%- if s.layout == 'feature_list' -%}
    <div class="mu-bpl">
      {%- if b != blank and b.articles_count > 0 -%}
        {%- liquid
          assign feature = b.articles.first
          assign excerpt = ''
          if s.show_excerpt
            assign excerpt = feature.excerpt_or_content | strip_html | truncatewords: 24
          endif
          assign feature_tag = ''
          if s.show_tag and feature.tags.size > 0
            assign feature_tag = feature.tags.first
          endif
        -%}
        <div class="mu-bpl__feature">
          {%- render 'mu-article-card', title: feature.title, url: feature.url, image: feature.image, date: feature.published_at, excerpt: excerpt, tag: feature_tag, featured: true, overlay: s.feature_overlay, scheme: s.feature_scheme -%}
        </div>
        {%- if b.articles_count > 1 -%}
          {%- assign list_limit = s.limit | minus: 1 | at_least: 1 -%}
          <ol class="mu-bpl__list">
            {%- for article in b.articles offset: 1 limit: list_limit -%}
              {%- liquid
                assign list_excerpt = ''
                if s.show_excerpt
                  assign list_excerpt = article.excerpt_or_content | strip_html | truncatewords: 18
                endif
                assign list_tag = ''
                if s.show_tag and article.tags.size > 0
                  assign list_tag = article.tags.first
                endif
                assign list_n = forloop.index | plus: 1
                assign list_num = list_n | prepend: '00' | slice: -2, 2
              -%}
              <li>
                <a class="mu-bpl__link" href="{{ article.url }}">
                  {%- if s.numbered -%}<span class="mu-bpl__no" aria-hidden="true">{{ list_num }}</span>{%- endif -%}
                  <span class="mu-bpl__copy">
                    {%- if s.show_date or list_tag != blank -%}
                      <span class="mu-bpl__meta mu-muted">
                        {%- if list_tag != blank -%}<span>{{ list_tag | escape }}</span>{%- endif -%}
                        {%- if s.show_date -%}{{ article.published_at | time_tag: format: 'date' }}{%- endif -%}
                      </span>
                    {%- endif -%}
                    <span class="mu-bpl__title">{{ article.title | escape }}</span>
                    {%- if list_excerpt != blank -%}<span class="mu-bpl__ex mu-muted">{{ list_excerpt }}</span>{%- endif -%}
                  </span>
                  <span class="mu-bpl__go" aria-hidden="true">{% render 'mu-icon', name: 'arrow' %}</span>
                </a>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
      {%- elsif request.design_mode -%}
        {%- assign ph_title = 'sections.blog_posts.placeholder' | t -%}
        <div class="mu-bpl__feature">
          {%- render 'mu-article-card', title: ph_title, url: '#', date: 'now', featured: true, overlay: s.feature_overlay, scheme: s.feature_scheme -%}
        </div>
        <ol class="mu-bpl__list">
          {%- for i in (2..3) -%}
            <li>
              <span class="mu-bpl__link">
                {%- if s.numbered -%}<span class="mu-bpl__no" aria-hidden="true">0{{ i }}</span>{%- endif -%}
                <span class="mu-bpl__copy"><span class="mu-bpl__title">{{ 'sections.blog_posts.placeholder' | t }}</span></span>
              </span>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  {%- else -%}
  <ul class="mu-fc__rail mu-rail mu-bp__rail" role="list">
    {%- if b != blank and b.articles_count > 0 -%}
      {%- for article in b.articles limit: s.limit -%}
        <li class="mu-fc__item">
          <article class="mu-bp__card">
            <a class="mu-bp__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}
                {%- liquid
                  comment
                    A third of the band on desktop, a 4:3 frame the photo covers (so a wider photo draws wider).
                  endcomment
                  assign cf = article.image.aspect_ratio | divided_by: 1.3333 | at_least: 1 | round: 3
                  assign bp_f = 0.3333 | times: cf
                  assign bp_t = 'calc(40vw * ' | append: cf | append: ')'
                  assign bp_m = 'calc((78vw - 40px) * ' | append: cf | append: ')'
                -%}
                {%- capture bp_sizes -%}{% render 'mu-sizes', sub: 135, f: bp_f, tab: bp_t, mob: bp_m %}{%- endcapture -%}
                {% render 'mu-img', image: article.image, max: 1600, sizes: bp_sizes %}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'mu-placeholder' }}
              {%- endif -%}
            </a>
            <div class="mu-bp__body">
              {%- if s.show_date or s.show_tag and article.tags.size > 0 -%}
                <p class="mu-bp__meta mu-muted">
                  {%- if s.show_tag and article.tags.size > 0 -%}<span class="mu-bp__tag">{{ article.tags.first | escape }}</span>{%- endif -%}
                  {%- if s.show_date -%}{{ article.published_at | time_tag: format: 'date' }}{%- endif -%}
                </p>
              {%- endif -%}
              <h3 class="mu-bp__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              {%- if s.show_excerpt -%}
                <p class="mu-bp__ex mu-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              {%- endif -%}
            </div>
          </article>
        </li>
      {%- endfor -%}
    {%- elsif request.design_mode -%}
      {%- for i in (1..3) -%}
        <li class="mu-fc__item">
          <article class="mu-bp__card">
            <span class="mu-bp__media">{{ i | modulo: 2 | plus: 1 | prepend: 'lifestyle-' | placeholder_svg_tag: 'mu-placeholder' }}</span>
            <div class="mu-bp__body"><h3 class="mu-bp__title">{{ 'sections.blog_posts.placeholder' | t }}</h3></div>
          </article>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
  {%- endif -%}
  {%- if request.design_mode and b == blank -%}
    <p class="mu-bp__pick mu-muted">{{ 'sections.blog_posts.pick' | t }}</p>
  {%- endif -%}
</div>
{%- render 'mu-section-style', s: section.settings, id: section.id -%}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "class": "mu-section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:settings.colors.scheme", "default": "scheme-5" },
    { "type": "header", "content": "t:sections.common.layout" },
    { "type": "checkbox", "id": "full_width", "label": "t:sections.common.bg_full", "info": "t:sections.common.bg_full_info", "default": false },
    { "type": "checkbox", "id": "custom_radius", "label": "t:sections.common.custom_radius", "info": "t:sections.common.custom_radius_info", "default": false, "visible_if": "{{ section.settings.full_width == false }}" },
    { "type": "range", "id": "radius", "label": "t:sections.common.radius", "min": 0, "max": 48, "step": 2, "unit": "px", "default": 24, "visible_if": "{{ section.settings.full_width == false and section.settings.custom_radius }}" },
    { "type": "checkbox", "id": "round_tl", "label": "t:sections.common.round_tl", "default": true, "visible_if": "{{ section.settings.full_width == false }}" },
    { "type": "checkbox", "id": "round_tr", "label": "t:sections.common.round_tr", "default": true, "visible_if": "{{ section.settings.full_width == false }}" },
    { "type": "checkbox", "id": "round_bl", "label": "t:sections.common.round_bl", "default": true, "visible_if": "{{ section.settings.full_width == false }}" },
    { "type": "checkbox", "id": "round_br", "label": "t:sections.common.round_br", "default": true, "visible_if": "{{ section.settings.full_width == false }}" },
    {
      "type": "select", "id": "layout", "label": "t:sections.blog_posts.layout", "default": "grid",
      "options": [
        { "value": "grid", "label": "t:sections.common.layout_grid" },
        { "value": "feature_list", "label": "t:sections.blog_posts.layout_feature_list" }
      ]
    },
    { "type": "checkbox", "id": "numbered", "label": "t:sections.blog_posts.numbered", "default": true, "visible_if": "{{ section.settings.layout == 'feature_list' }}" },
    { "type": "checkbox", "id": "feature_overlay", "label": "t:sections.blog_posts.feature_overlay", "info": "t:sections.blog_posts.feature_overlay_info", "default": true, "visible_if": "{{ section.settings.layout == 'feature_list' }}" },
    { "type": "color_scheme", "id": "feature_scheme", "label": "t:sections.main_blog.feature_scheme", "default": "scheme-2", "visible_if": "{{ section.settings.layout == 'feature_list' }}" },
    { "type": "text", "id": "heading", "label": "t:sections.common.heading", "default": "From the journal" },
    { "type": "blog", "id": "blog", "label": "t:sections.blog_posts.blog" },
    { "type": "range", "id": "limit", "label": "t:sections.blog_posts.limit", "min": 2, "max": 9, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_link", "label": "t:sections.featured_collection.show_link", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "t:sections.blog_posts.show_date", "default": true },
    { "type": "checkbox", "id": "show_tag", "label": "t:sections.blog_posts.show_tag", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "t:sections.blog_posts.show_excerpt", "default": false },
    { "type": "header", "content": "t:sections.common.animation" },
    { "type": "checkbox", "id": "animate", "label": "t:sections.common.animate", "info": "t:sections.common.animate_info", "default": true }
  ],
  "presets": [{ "name": "t:sections.blog_posts.name" }]
}
{% endschema %}
