{%- comment -%}
  Image with text: one panel, the photo on one side and the copy (with its button) on the other.
  Overlay layout: the photo fills the stage and the copy sits on it (bottom left, centre or top left) over a tint of
  the scheme's background, so a dark scheme gives light text on a darkened photo and a light scheme the reverse.
  Max image height (desktop from 990px, mobile below): lowers the photo's height, cropping it around its focal point;
  the section still grows when the copy needs more room, so text is never cut off. None keeps the default height.
{%- endcomment -%}
{{ 'mu-sections.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign overlay = false
  if s.image_side == 'overlay'
    assign overlay = true
  endif
  comment
    The photo covers its frame, so a photo wider than the frame is drawn wider by that much. Side by side: half the
    stage, at least 540px tall on desktop and 4:3 below. Overlay: the whole stage, clamp(460px, 125vw, 640px) tall
    on phones.
  endcomment
  assign ar = 1.5
  if s.image != blank
    assign ar = s.image.aspect_ratio
  endif
  assign bleed = true
  if section.settings.full_width == false
    assign bleed = false
  endif
  if overlay
    assign it_m = 125 | times: ar | at_least: 100 | round
    assign it_m = 'calc(' | append: it_m | append: 'vw - 20px)'
    capture it_sizes
      render 'mu-sizes', sub: 68, f: 1, tab: 'calc(100vw - 60px)', mob: it_m, nocap: bleed
    endcapture
  else
    assign kd = ar | divided_by: 1.27 | at_least: 1 | times: 0.5 | round: 3
    assign km = ar | divided_by: 1.3333 | at_least: 1 | round: 3
    assign it_m = 'calc((100vw - 40px) * ' | append: km | append: ')'
    capture it_sizes
      render 'mu-sizes', sub: 68, f: kd, mob: it_m, nocap: bleed
    endcapture
  endif
  assign mhd = s.max_height | default: 'none'
  assign mhm = s.max_height_mobile | default: 'none'
  capture it_style
    if overlay
      echo '--mu-it-o: ' | append: s.overlay_opacity | append: '%;'
    endif
    if mhd != 'none'
      echo ' --mu-it-mhd: ' | append: mhd | append: 'px;'
    endif
    if mhm != 'none'
      echo ' --mu-it-mhm: ' | append: mhm | append: 'px;'
    endif
    unless bleed
      echo ' '
      render 'mu-surface', s: s, part: 'style'
    endunless
  endcapture
  assign it_style = it_style | strip
-%}
{%- capture demo_it -%}
  {%- render 'mu-demo-image', asset: s.demo_image, class: 'mu-it__img', sizes: it_sizes -%}
{%- endcapture -%}
{%- assign demo_it = demo_it | strip -%}
<div class="mu-sec mu-it {% unless section.settings.full_width == false %} mu-bleed{% endunless %} color-{{ s.color_scheme }}{% unless bleed %}{% render 'mu-surface', s: s %}{% endunless %}{% if s.image_side == 'right' %} mu-it--right{% endif %}{% if overlay %} mu-it--overlay mu-it--at-{{ s.overlay_position }}{% endif %}{% if mhd != 'none' %} mu-it--mhd{% endif %}{% if mhm != 'none' %} mu-it--mhm{% endif %}"{% if it_style != blank %} style="{{ it_style }}"{% endif %}{% render 'mu-anim', on: section.settings.animate, items: '.mu-it__copy > *', p: '.mu-it__media' %}>
  <div class="mu-it__media">
    {%- if s.image != blank -%}
      {% render 'mu-img', image: s.image, class: 'mu-it__img', sizes: it_sizes, alt: s.image.alt %}
    {%- elsif demo_it != '' -%}
      {{ demo_it }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'mu-it__img mu-placeholder' }}
    {%- endif -%}
    {% content_for 'blocks' %}
  </div>
  <div class="mu-it__copy">
    {%- if s.eyebrow != blank -%}<p class="mu-eyebrow mu-muted">{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 class="mu-it__title mu-h2">{{ s.heading }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="mu-it__text mu-rte mu-muted">{{ s.text }}</div>{%- endif -%}
    {%- if s.cta_label != blank -%}
      <a class="mu-btn mu-it__cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label | escape }}{% render 'mu-icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
</div>
{%- render 'mu-section-style', s: section.settings, id: section.id -%}

